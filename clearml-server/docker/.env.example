# ClearML SSO Configuration

CLEARML_SSO_ENABLED=true

CLEARML_SSO_ISSUER=https://auth.example.com/application/o/clearml/
CLEARML_SSO_CLIENT_ID=replace-with-client-id
CLEARML_SSO_CLIENT_SECRET=replace-with-client-secret
CLEARML_SSO_STATE_SECRET=replace-with-random-secret

CLEARML_SSO_CALLBACK_URL=https://clearml.example.com/sso/callback
CLEARML_SSO_WEB_URL=https://clearml.example.com/

CLEARML_SSO_DEFAULT_COMPANY=research
CLEARML_SSO_TOKEN_TTL_SEC=3600

CLEARML_SSO_ADMIN_ISSUER=https://auth.example.com/application/o/clearml/
CLEARML_SSO_ADMIN_SUB=replace-with-admin-subject
